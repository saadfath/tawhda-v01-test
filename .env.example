# Copy this file to .env.local and fill in your own Supabase project values.
# .env.local is git-ignored. These two values are public by design (RLS
# protects the data); never put the service-role key in a VITE_* variable.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY_HERE

# Without the two values above the app runs in local demo mode: questions and
# answer keys are bundled in the browser solely so the UI can be tested.
# With them, the demo module is replaced by an empty stub at build time.
# A normal `npm run build` refuses to run without both values. For the local
# demo build use `npm run build:demo` and never deploy its output publicly.

# Set this in the Supabase dashboard (Edge Functions → Secrets), not here:
# SITE_ORIGIN=https://your-production-domain.example
